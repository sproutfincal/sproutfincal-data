  "schemeNotes": [
    {
      "schemeId": "ppf",
      "text": {
        "en": "PPF has a 15-year lock-in. You can deposit between ₹500 and ₹1.5 lakh in a financial year, and the interest is tax-free.",
        "hi": "PPF में 15 साल का लॉक-इन होता है। एक वित्त वर्ष में ₹500 से ₹1.5 लाख तक जमा कर सकते हैं, और ब्याज कर-मुक्त है।"
      }
    },
    {
      "schemeId": "ssa",
      "text": {
        "en": "Sukanya Samriddhi can be opened for a girl child under 10 years. Deposits of ₹250 to ₹1.5 lakh a year are allowed for 15 years.",
        "hi": "सुकन्या समृद्धि खाता 10 साल से कम उम्र की बालिका के लिए खुल सकता है। 15 साल तक हर साल ₹250 से ₹1.5 लाख जमा किए जा सकते हैं।"
      }
    },
    {
      "schemeId": "scss",
      "text": {
        "en": "SCSS is for people aged 60 and above. The term is 5 years and the maximum deposit is ₹30 lakh. Interest is paid quarterly.",
        "hi": "SCSS 60 वर्ष और उससे अधिक उम्र के लोगों के लिए है। अवधि 5 साल है और अधिकतम जमा ₹30 लाख है। ब्याज तिमाही मिलता है।"
      }
    },
    {
      "schemeId": "nsc",
      "text": {
        "en": "NSC has a 5-year term. Interest is compounded yearly and paid at maturity.",
        "hi": "NSC की अवधि 5 साल है। ब्याज सालाना चक्रवृद्धि होता है और परिपक्वता पर मिलता है।"
      }
    }
  ]
